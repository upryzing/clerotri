{
  "name": "rvmob",
  "version": "0.15.0",
  "homepage": "https://upryzing.github.io/clerotri",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "clean": "react-native clean",
    "android": "yarn prebuild && rnx-cli run-android --active-arch-only --appIdSuffix=debug --mode=debug",
    "android-release": "yarn android-release:bundle && yarn android-release:apk",
    "android-release:apk": "rnx-cli build-android --tasks assembleRelease",
    "android-release:apkset": "rm android/app/build/outputs/apkset/release/app-release.apks -f && rnx-cli build-android --tasks buildApksRelease",
    "android-release:bundle": "yarn prebuild && rnx-cli bundle --dev false --metafile dist/sus.json && yarn android-release:copy-assets",
    "android-release:copy-assets": "mkdir -p android/app/build/generated/assets/react/release && mkdir -p android/app/build/generated/res/react/release && cp dist/android/index.android.bundle.hbc android/app/build/generated/assets/react/release/index.android.bundle && cp -r dist/android/res android/app/build/generated/res/react/release && cp -r dist/android/res/drawable-mdpi/ android/app/src/main/res/drawable-mdpi/",
    "android-release:full": "yarn android-release && yarn android-release:apkset",
    "ios": "react-native run-ios",
    "start": "react-native rnx-start",
    "test": "vitest run -c config/vite.config.ts",
    "lint": "eslint .",
    "format": "prettier -w src/ docs/ i18n/*.ts scripts/ *.md",
    "license-list": "yarn licenses list --production --json --recursive > assets/data/licenses.json && node scripts/licenseListProcessor.mjs -silent",
    "metadata": "node scripts/metadataGenerator.mjs",
    "prebuild": "yarn metadata && yarn license-list -prod",
    "web": "yarn prebuild && vite -c config/vite.config.ts",
    "web-release": "yarn prebuild && vite build -c config/vite.config.ts",
    "web-preview": "yarn prebuild && vite preview -c config/vite.config.ts",
    "knip": "knip"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@legendapp/list": "^3.7.3",
    "@notifee/react-native": "^9.1.8",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/hooks": "^100.1.0",
    "@react-native-documents/picker": "^12.1.0",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@react-native-vector-icons/material-icons": "^14.0.0",
    "@rexovolt/react-native-markdown-display": "^10.0.1",
    "@traptitech/markdown-it-spoiler": "patch:@traptitech/markdown-it-spoiler@npm%3A1.1.6#~/.yarn/patches/@traptitech-markdown-it-spoiler-npm-1.1.6-ee0dc02626.patch",
    "@xmldom/xmldom": "^0.9.12",
    "date-fns": "^4.4.0",
    "i18next": "^27.2.3",
    "intl-pluralrules": "^2.0.1",
    "mobx": "^6.16.1",
    "mobx-react-lite": "^4.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^18.0.3",
    "react-native": "^0.86.3",
    "react-native-device-info": "patch:react-native-device-info@npm%3A15.0.2#~/.yarn/patches/react-native-device-info-npm-15.0.2-3917c98f43.patch",
    "react-native-drawer-layout": "^4.2.13",
    "react-native-gesture-handler": "patch:react-native-gesture-handler@npm%3A3.5.0#~/.yarn/patches/react-native-gesture-handler-npm-3.5.0-3a30d7e922.patch",
    "react-native-get-random-values": "^2.1.0",
    "react-native-keyboard-controller": "^1.23.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "patch:react-native-nitro-modules@npm%3A0.37.1#~/.yarn/patches/react-native-nitro-modules-npm-0.37.1-d46109edee.patch",
    "react-native-reanimated": "patch:react-native-reanimated@npm%3A4.7.2#~/.yarn/patches/react-native-reanimated-npm-4.7.2-b6434f6690.patch",
    "react-native-reanimated-image-viewer": "^1.0.2",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-svg": "^15.16.1",
    "react-native-unistyles": "3.8.2",
    "react-native-web": "^0.19.13",
    "react-native-worklets": "patch:react-native-worklets@npm%3A0.13.1#~/.yarn/patches/react-native-worklets-npm-0.13.1-3a63e554a7.patch",
    "reanimated-color-picker": "^5.1.4",
    "revolt.js": "npm:@rexovolt/revolt.js@^6.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/runtime": "^7.29.15",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/eslint-config": "^0.86.3",
    "@react-native/metro-config": "^0.86.3",
    "@react-native/typescript-config": "^0.86.3",
    "@rnx-kit/babel-preset-metro-react-native": "^4.0.2",
    "@rnx-kit/cli": "^2.0.8",
    "@rnx-kit/metro-config": "^2.2.6",
    "@rnx-kit/metro-resolver-symlinks": "^0.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-native-web": "^0.19.2",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-native-web": "^0.20.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.5",
    "eslint-plugin-de-morgan": "^1.3.1",
    "knip": "^5.88.1",
    "prettier": "^3.10.1",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-react-native-web": "^2.7.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.19.0",
  "rnx-kit": {
    "bundle": {
      "entryFile": "index.js",
      "targets": [
        "android"
      ],
      "platforms": {
        "android": {
          "bundleOutput": "dist/android/index.android.bundle",
          "sourcemapOutput": "dist/android/index.android.bundle.map",
          "assetsDest": "dist/android/res"
        }
      },
      "treeShake": true,
      "hermes": true,
      "plugins": [
        [
          "@rnx-kit/metro-plugin-cyclic-dependencies-detector",
          {
            "includeNodeModules": false,
            "linesOfContext": 3,
            "throwOnError": true
          }
        ],
        [
          "@rnx-kit/metro-plugin-duplicates-checker",
          {
            "ignoredModules": [
              "react-is"
            ]
          }
        ]
      ]
    }
  }
}
